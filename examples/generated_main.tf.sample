########################################################################
# Generated by the DevOps agent for request: req-874ae3d3b1
# User ask: I want to deploy an S3 bucket
# Do not hand-edit -- regenerated on every remediation pass.
########################################################################

resource "aws_s3_bucket" "this" {
  bucket = "build-artifacts-874ae3d3"

  tags = {
    Project = "devops-agent"
    RequestId = "req-874ae3d3b1"
    ManagedBy = "devops-agent"
  }
}

resource "aws_s3_bucket_versioning" "this" {
  bucket = aws_s3_bucket.this.id
  versioning_configuration {
    status = "Enabled"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "this" {
  bucket = aws_s3_bucket.this.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
    bucket_key_enabled = true
  }
}

resource "aws_s3_bucket_public_access_block" "this" {
  bucket = aws_s3_bucket.this.id

  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket" "log_bucket" {
  bucket = "build-artifacts-874ae3d3-logs"

  tags = {
    ManagedBy = "devops-agent"
    Purpose   = "access-logs"
  }
}

resource "aws_s3_bucket_public_access_block" "log_bucket" {
  bucket                  = aws_s3_bucket.log_bucket.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# The log target bucket is itself in scope for the CIS gate, so it gets the
# same versioning baseline as the primary bucket regardless of what the
# caller asked for -- an unversioned audit trail is not a real audit trail.
resource "aws_s3_bucket_versioning" "log_bucket" {
  bucket = aws_s3_bucket.log_bucket.id
  versioning_configuration {
    status = "Enabled"
  }
}

# S3 access logging requires the log-delivery service to be allowed to write
# into the target bucket. Real AWS (and LocalStack) reject
# aws_s3_bucket_logging without this policy in place first.
data "aws_iam_policy_document" "log_bucket_policy" {
  statement {
    sid     = "S3ServerAccessLogsPolicy"
    effect  = "Allow"
    actions = ["s3:PutObject"]

    resources = ["${aws_s3_bucket.log_bucket.arn}/log/*"]

    principals {
      type        = "Service"
      identifiers = ["logging.s3.amazonaws.com"]
    }

    condition {
      test     = "ArnLike"
      variable = "aws:SourceArn"
      values   = [aws_s3_bucket.this.arn]
    }
  }
}

resource "aws_s3_bucket_policy" "log_bucket_policy" {
  bucket = aws_s3_bucket.log_bucket.id
  policy = data.aws_iam_policy_document.log_bucket_policy.json
}

resource "aws_s3_bucket_logging" "this" {
  bucket = aws_s3_bucket.this.id

  target_bucket = aws_s3_bucket.log_bucket.id
  target_prefix = "log/"

  depends_on = [aws_s3_bucket_policy.log_bucket_policy]
}


output "bucket_name" {
  value = aws_s3_bucket.this.id
}

output "bucket_arn" {
  value = aws_s3_bucket.this.arn
}