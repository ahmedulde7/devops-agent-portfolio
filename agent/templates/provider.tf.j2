terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

# Points the AWS provider at LocalStack instead of real AWS. Credentials are
# dummy values on purpose -- LocalStack does not validate them.
provider "aws" {
  region                      = "{{ region }}"
  access_key                  = "test"
  secret_key                  = "test"
  s3_use_path_style           = true
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requesting_account_id  = true

  endpoints {
    s3  = "{{ localstack_endpoint }}"
    iam = "{{ localstack_endpoint }}"
    sts = "{{ localstack_endpoint }}"
  }
}
